<Window x:Class="SunoMetatagApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SunoMetatagApp"
        xmlns:vm="clr-namespace:SunoMetatagApp.ViewModels"
        xmlns:m="clr-namespace:SunoMetatagApp.Models"
        Title="Suno Metatag Editor"
        Width="1300" Height="750"
        MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SunoSurfaceBackgroundBrush}"
        Foreground="{StaticResource SunoTextPrimaryBrush}"
        FontFamily="{StaticResource SunoFontPrimary}"
        FontSize="{StaticResource SunoFontSizeBody}"
        TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <local:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
        <local:StringIsNotEmptyConverter x:Key="StringIsNotEmptyConverter" />
    </Window.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="240" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="4*" MinWidth="360" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="3*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- Left: preview pane -->
        <DockPanel Grid.Column="0" Margin="4">
            <Button DockPanel.Dock="Top"
                    Style="{StaticResource SunoPrimaryButton}"
                    Content="Copy all"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    Command="{Binding CopyPreviewCommand}"
                    ToolTip="Copy the assembled prompt to the clipboard" />

            <Border Style="{StaticResource SunoPreviewCard}">
                <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource SunoTextPrimaryBrush}"
                         FontFamily="{StaticResource SunoFontMono}"
                         FontSize="{StaticResource SunoFontSizeBody}"
                         CaretBrush="{StaticResource SunoAccentPrimaryBrush}"
                         SelectionBrush="{StaticResource SunoAccentPrimarySoftBrush}"
                         Padding="0" />
            </Border>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" Cursor="SizeWE"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Middle: section stack -->
        <DockPanel Grid.Column="2" Margin="4">
            <Button DockPanel.Dock="Bottom"
                    Style="{StaticResource SunoPrimaryButton}"
                    Content="+ Add section"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    Command="{Binding AddSectionCommand}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Background="Transparent">
                <ItemsControl x:Name="SectionsHost" ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Section}">
                            <!-- SunoSectionCard provides chrome + focused-state Trigger
                                 via IsKeyboardFocusWithin. v1.1 carry-over mechanism. -->
                            <Border Style="{StaticResource SunoSectionCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Toolbar row: ▲ ▼ × -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                                HorizontalAlignment="Right" Margin="0,0,0,4">
                                        <Button Style="{StaticResource SunoIconButton}"
                                                Content="▲"
                                                Margin="0,0,3,0"
                                                ToolTip="Move section up"
                                                Command="{Binding DataContext.MoveSectionUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource SunoIconButton}"
                                                Content="▼"
                                                Margin="0,0,3,0"
                                                ToolTip="Move section down"
                                                Command="{Binding DataContext.MoveSectionDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource SunoIconButton}"
                                                Content="×"
                                                FontWeight="Bold"
                                                ToolTip="Delete this section"
                                                Click="DeleteSectionButton_Click"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <!-- Lyric textbox (focus events drive VM caret tracking) -->
                                    <TextBox Grid.Row="1"
                                             Style="{StaticResource SunoLyricTextBox}"
                                             Text="{Binding Lyrics, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="LyricTextBox_GotFocus"
                                             LostKeyboardFocus="LyricTextBox_LostFocus"
                                             SelectionChanged="LyricTextBox_SelectionChanged" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="3" Width="6" Cursor="SizeWE"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Right: tag picker -->
        <Grid Grid.Column="4" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Error banner -->
            <Border Grid.Row="0"
                    Style="{StaticResource SunoErrorBanner}"
                    Margin="0,0,0,8"
                    Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsedConverter}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource SunoButton}"
                            Content="Copy"
                            Click="CopyErrorButton_Click"
                            ToolTip="Copy error message to clipboard" />
                    <TextBlock Text="{Binding LoadError}"
                               Foreground="{StaticResource SunoErrorTextBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Search box -->
            <Grid Grid.Row="1">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource SunoTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,4"
                         ToolTip="Search tags (case-insensitive)" />
                <TextBlock IsHitTestVisible="False"
                           Text="Search tags…"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SunoTextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource SunoTextSecondaryBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Category dropdown -->
            <ComboBox Grid.Row="2"
                      Style="{StaticResource SunoComboBox}"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      Margin="0,0,0,8"
                      ToolTip="Filter by category" />

            <!-- Scrollable button grid + empty-state -->
            <Grid Grid.Row="3">
                <ScrollViewer x:Name="TagPickerScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              KeyboardNavigation.TabNavigation="Once"
                              KeyboardNavigation.DirectionalNavigation="Contained">
                    <ScrollViewer.Resources>
                        <!--
                            v1.1 carry-over (now r2-tuned per spec §4.4):
                            Picker-scoped Style with BasedOn the NAMED SunoTagPill key.
                            If SunoTagPill key is missing/renamed, this BasedOn fails
                            silently → picker loses Focusable=False → focus-flip-stale-
                            insert risk (wiki risks/focus-flip-stale-insert.md) returns.

                            Triggers preserved:
                            - Focusable=False on all picker buttons
                            - DataTrigger on FocusedSection==null → dim affordance:
                              Opacity = SunoOpacityDim (0.7, tuned from v1.1 0.55)
                              Foreground swap to SunoTextDisabledBrush (specialist MEDIUM-2 option c)
                              ToolTip swap to discoverability hint
                        -->
                        <Style TargetType="Button" BasedOn="{StaticResource SunoTagPill}">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Opacity" Value="1.0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.FocusedSection}" Value="{x:Null}">
                                    <Setter Property="Opacity" Value="{StaticResource SunoOpacityDim}" />
                                    <Setter Property="Foreground" Value="{StaticResource SunoTextDisabledBrush}" />
                                    <Setter Property="ToolTip" Value="Click in a lyric textbox first, then click a tag." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding FilteredTags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Bracket}"
                                        ToolTip="{Binding Description}"
                                        ToolTipService.IsEnabled="{Binding Description, Converter={StaticResource StringIsNotEmptyConverter}}"
                                        Command="{Binding DataContext.InsertTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="No tags match"
                           HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="0,12,0,0"
                           Foreground="{StaticResource SunoTextSecondaryBrush}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource SunoTextSecondaryBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredTags.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>
