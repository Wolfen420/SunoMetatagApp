<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- ====================================================================
         Suno design tokens — canonical token table.
         Reference: docs/specs/2026-05-26-suno-visual-redesign.md §2
         ==================================================================== -->

    <!-- §2.1 Color tokens -->
    <Color x:Key="SunoSurfaceBackgroundColor">#FF0F0F12</Color>
    <Color x:Key="SunoSurfaceCardColor">#FF1A1A22</Color>
    <Color x:Key="SunoSurfaceCardElevatedColor">#FF22222C</Color>
    <Color x:Key="SunoBorderSubtleColor">#FF2A2A35</Color>
    <Color x:Key="SunoBorderStrongColor">#FF3A3A48</Color>
    <Color x:Key="SunoAccentPrimaryColor">#FF8B5CF6</Color>
    <Color x:Key="SunoAccentPrimaryTextColor">#FFA78BFA</Color>
    <Color x:Key="SunoAccentPrimarySoftColor">#3A8B5CF6</Color>
    <Color x:Key="SunoAccentSecondaryColor">#FFEC4899</Color>
    <!-- Pinkish-purple (fuchsia) for tag pills — per user direction 2026-05-26. -->
    <Color x:Key="SunoAccentPillColor">#FFD946EF</Color>
    <Color x:Key="SunoAccentPillHoverColor">#FFE879F9</Color>
    <Color x:Key="SunoAccentPillPressedColor">#FFC026D3</Color>
    <Color x:Key="SunoTextPrimaryColor">#FFE5E5EB</Color>
    <Color x:Key="SunoTextSecondaryColor">#FF9A9AA8</Color>
    <Color x:Key="SunoTextDisabledColor">#FF5A5A66</Color>
    <Color x:Key="SunoErrorBgColor">#FF3A1A1A</Color>
    <Color x:Key="SunoErrorTextColor">#FFFCA5A5</Color>

    <!-- §2.2 Brush tokens (one SolidColorBrush per Color) -->
    <SolidColorBrush x:Key="SunoSurfaceBackgroundBrush" Color="{StaticResource SunoSurfaceBackgroundColor}" />
    <SolidColorBrush x:Key="SunoSurfaceCardBrush" Color="{StaticResource SunoSurfaceCardColor}" />
    <SolidColorBrush x:Key="SunoSurfaceCardElevatedBrush" Color="{StaticResource SunoSurfaceCardElevatedColor}" />
    <SolidColorBrush x:Key="SunoBorderSubtleBrush" Color="{StaticResource SunoBorderSubtleColor}" />
    <SolidColorBrush x:Key="SunoBorderStrongBrush" Color="{StaticResource SunoBorderStrongColor}" />
    <SolidColorBrush x:Key="SunoAccentPrimaryBrush" Color="{StaticResource SunoAccentPrimaryColor}" />
    <SolidColorBrush x:Key="SunoAccentPrimaryTextBrush" Color="{StaticResource SunoAccentPrimaryTextColor}" />
    <SolidColorBrush x:Key="SunoAccentPrimarySoftBrush" Color="{StaticResource SunoAccentPrimarySoftColor}" />
    <SolidColorBrush x:Key="SunoAccentSecondaryBrush" Color="{StaticResource SunoAccentSecondaryColor}" />
    <SolidColorBrush x:Key="SunoAccentPillBrush" Color="{StaticResource SunoAccentPillColor}" />
    <SolidColorBrush x:Key="SunoAccentPillHoverBrush" Color="{StaticResource SunoAccentPillHoverColor}" />
    <SolidColorBrush x:Key="SunoAccentPillPressedBrush" Color="{StaticResource SunoAccentPillPressedColor}" />
    <SolidColorBrush x:Key="SunoTextPrimaryBrush" Color="{StaticResource SunoTextPrimaryColor}" />
    <SolidColorBrush x:Key="SunoTextSecondaryBrush" Color="{StaticResource SunoTextSecondaryColor}" />
    <SolidColorBrush x:Key="SunoTextDisabledBrush" Color="{StaticResource SunoTextDisabledColor}" />
    <SolidColorBrush x:Key="SunoErrorBgBrush" Color="{StaticResource SunoErrorBgColor}" />
    <SolidColorBrush x:Key="SunoErrorTextBrush" Color="{StaticResource SunoErrorTextColor}" />
    <SolidColorBrush x:Key="SunoTransparentBrush" Color="Transparent" />

    <!-- §2.3 Typography tokens -->
    <FontFamily x:Key="SunoFontPrimary">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="SunoFontMono">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
    <system:Double x:Key="SunoFontSizeSmall">11</system:Double>
    <system:Double x:Key="SunoFontSizeLabel">12</system:Double>
    <system:Double x:Key="SunoFontSizeBody">13</system:Double>
    <system:Double x:Key="SunoFontSizeHeader">14</system:Double>

    <!-- §2.4 Spacing, radius, thickness, opacity tokens -->
    <system:Double x:Key="SunoSpacingXS">4</system:Double>
    <system:Double x:Key="SunoSpacingS">8</system:Double>
    <system:Double x:Key="SunoSpacingM">12</system:Double>
    <system:Double x:Key="SunoSpacingL">16</system:Double>
    <system:Double x:Key="SunoSpacingXL">24</system:Double>

    <CornerRadius x:Key="SunoRadiusS">4</CornerRadius>
    <CornerRadius x:Key="SunoRadiusM">6</CornerRadius>
    <CornerRadius x:Key="SunoRadiusL">8</CornerRadius>
    <CornerRadius x:Key="SunoRadiusPill">12</CornerRadius>

    <Thickness x:Key="SunoBorderThicknessThin">1</Thickness>
    <Thickness x:Key="SunoBorderThicknessFocused">2</Thickness>

    <Thickness x:Key="SunoPaddingControl">8,4</Thickness>
    <Thickness x:Key="SunoPaddingCard">12</Thickness>
    <Thickness x:Key="SunoPaddingIconButton">6,2</Thickness>

    <system:Double x:Key="SunoOpacityDim">0.7</system:Double>

</ResourceDictionary>
